# Rust
/target
**/*.rs.bk
*.pdb

# Cargo.lock IS committed for this workspace (binaries) - do not ignore it.

# Real secrets must never be committed.
.env
.env.*
!.env.example
# NOTE: `.secrets.yaml` written by `sotto init` is meant to be COMMITTED (no secrets in it).

# Completed restore-rehearsal records. The template in deploy/ORGANISATION-DELETION-RUNBOOK.md is
# public documentation; a filled-in record describes one live deployment (bucket names, object
# checksums, and whatever weaknesses the rehearsal found) and must stay out of a public repository.
deploy/rehearsals/

# WASM build artefacts
/crates/wasm/pkg

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Internal planning docs - kept out of the public open-core repo.
docs/

# Python bytecode. CONTRIBUTING.md runs the script tests with -B so none is written; this is
# for the times a bare python3 invocation makes some anyway.
__pycache__/
*.pyc

# Promo and demo media. Large binaries that belong wherever the rest of the video work lives,
# not in a repository people clone for the source. Present here as working files, and ignored so
# a `git add -A` cannot sweep twenty megabytes of mp4 into a commit about something else, which
# is exactly how they arrived in #188.
demo/
