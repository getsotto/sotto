# Sotto - same-origin deployment.
#
# Serves the built web app and reverse-proxies the API through ONE origin, so the session cookie
# and CSP `connect-src 'self'` stay simple, and no CORS is needed. Caddy provisions HTTPS
# automatically for a real domain.
#
#   1. Build the web app:   cd web && npm ci && npm run build     # → web/dist
#   2. Run the API:         DATABASE_URL=… GITHUB_CLIENT_ID=… GITHUB_CLIENT_SECRET=… \
#                           SOTTO_PUBLIC_URL=https://app.example.com \
#                           SOTTO_WEB_ORIGIN=https://app.example.com  sotto-server
#   3. Run Caddy:           SOTTO_DOMAIN=app.example.com SOTTO_API=127.0.0.1:8080  caddy run
#
# Register the GitHub OAuth app's callback as https://app.example.com/auth/github/callback (same
# origin as the web app), matching SOTTO_PUBLIC_URL.
#
# NOTE: `rate_limit` (below) is the caddy-ratelimit plugin, not a standard directive. The deploy
# image is an xcaddy build that bundles it (deploy/Dockerfile.web); a stock `caddy` binary will
# reject this config.
{
	# rate_limit is a non-standard (plugin) directive, so its place in the handler chain must be
	# declared - run it before the proxy so throttling happens before the request reaches the API.
	order rate_limit before reverse_proxy
}

# Canonical host: fold the www subdomain onto the apex so every link and share lands on
# the single origin the landing page declares as canonical. Derived from SOTTO_DOMAIN, so
# each deployment redirects its own www subdomain with no file edits.
www.{$SOTTO_DOMAIN} {
	redir https://{$SOTTO_DOMAIN}{uri} permanent
}

{$SOTTO_DOMAIN:localhost} {
	encode gzip

	# JSON access logs - ops forensics and the funnel's demand counter: a 402 in these logs is a
	# free-tier limit hit. Written to the caddy_logs volume (deploy/docker-compose.prod.yml) and
	# rotated by Caddy itself. Credential headers are DELETED from every entry by the filter
	# below - enforced here in config, not left to Caddy's default redaction (which has masked
	# these values since v2.5 but can be re-enabled with `log_credentials`). See
	# deploy/README.md § Access logs for the reading commands.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Proxy-Authorization delete
				resp_headers>Set-Cookie delete
				# Not a credential header, and Caddy's default redaction never touches it: the OAuth
				# callback's redirect to a CLI login carries the new session token in its query.
				resp_headers>Location delete
			}
		}
	}

	# Per-client-IP rate limits on the UNAUTHENTICATED endpoints - the only API surface with no
	# credential wall: the OAuth login/callback (which writes a short-lived login-state row), the
	# public share fetch, the landing-page community snapshot, the anonymous telemetry ping (a 503
	# no-op unless this instance sets SOTTO_TELEMETRY_INGEST=1), and the readiness probe, which
	# queries Postgres for anyone who asks. Caddy is the edge here, so {remote_host} is the real
	# client IP, not a proxied one. Authenticated sync (/account, /projects, /environments/*,
	# /orgs, /machine/*, …) is deliberately NOT limited: it is bearer-gated and includes
	# high-frequency CI polling that a per-IP cap could wrongly throttle when a whole team shares
	# one office/NAT egress IP. The threshold is a generous starting point - raise it, or split
	# into per-endpoint zones, to taste. Contact-verification POSTs are the deliberate exception:
	# their dedicated per-IP zone below complements account/destination limits in the application.
	@ratelimited path /auth/github/* /shares /shares/* /community /telemetry/* /health/ready /webhooks/resend
	handle @ratelimited {
		rate_limit {
			zone unauthenticated {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy {$SOTTO_API:127.0.0.1:8080}
	}

	# Verification sends are authenticated but can still be abused to generate provider traffic.
	# Keep a dedicated per-IP ceiling in addition to the account/destination limits in Postgres.
	@contact_verification {
		method POST
		path /account/contacts/verification /account/contacts/verification/confirm
	}
	handle @contact_verification {
		rate_limit {
			zone contact_verification {
				key {remote_host}
				events 20
				window 1m
			}
		}
		reverse_proxy {$SOTTO_API:127.0.0.1:8080}
	}

	# Keep protected lifecycle snapshots bounded too; their database work is authenticated but
	# aggregates may touch many durable rows on a compact host.
	@cloud_operations_read {
		method GET
		path /ops/cloud/metrics /ops/cloud/coverage-rejections
	}
	handle @cloud_operations_read {
		rate_limit {
			zone cloud_operations_read {
				key {remote_host}
				events 30
				window 1m
			}
		}
		reverse_proxy {$SOTTO_API:127.0.0.1:8080}
	}

	# Provider-backed diagnostic repair can make bounded Stripe reads. Keep a per-IP ceiling even
	# though it also requires its dedicated operator credential.
	@cloud_coverage_repair {
		method POST
		path /ops/cloud/coverage-rejections/*
	}
	handle @cloud_coverage_repair {
		rate_limit {
			zone cloud_coverage_repair {
				key {remote_host}
				events 10
				window 1m
			}
		}
		reverse_proxy {$SOTTO_API:127.0.0.1:8080}
	}

	# The rest of the server's API (bearer-authenticated), plus the dependency-free liveness probe.
	# Together with @ratelimited above this must cover every path the routers in
	# `crates/server/src/lib.rs` serve - keep the two in sync. Note that `path` matches exactly, so
	# /health does not cover /health/ready: a new sub-path needs its own entry or it falls through
	# to the SPA below and answers a probe with HTML.
	@api path /health /server/info /auth/me /auth/logout /account /account/* /projects /projects/* /environments/* /orgs /orgs/* /machine/* /billing/* /ops/organisation-deletion/metrics /ops/organisation-deletion/* /ops/billing/transfers/* /ops/billing/founding-price-notices /ops/cloud/metrics /ops/cloud/coverage-rejections /ops/cloud/coverage-rejections/* /ops/cloud/retention /ops/cloud/retention/* /ops/cloud/notices /ops/cloud/notices/*
	handle @api {
		reverse_proxy {$SOTTO_API:127.0.0.1:8080}
	}

	# Fold trailing slashes on the six indexable guide slugs onto their canonical clean URLs
	# so crawlers and no-script visitors get the prerendered guide, not the homepage snapshot.
	# Keep in sync with `guidePages` in web/src/seo/pages.ts. Ordinary SPA routes (`/app/`,
	# `/s/:token`, unknown paths) are left to try_files below.
	redir /share-secrets-securely/ /share-secrets-securely permanent
	redir /share-env-files/ /share-env-files permanent
	redir /one-time-secret-links/ /one-time-secret-links permanent
	redir /share-api-keys-securely/ /share-api-keys-securely permanent
	redir /send-password-securely/ /send-password-securely permanent
	redir /self-hosted-secret-management/ /self-hosted-secret-management permanent

	# Everything else is the SPA, including client-side routes (/, /app, /s/:token, /auth/callback).
	# The middle branch serves the prerendered guide files the build emits (`/<slug>` reads
	# `/<slug>.html`), so crawlers get each guide's own snapshot and head tags. Anything else
	# still falls back to the app shell, and React routes it client-side.
	handle {
		root * ./web/dist
		try_files {path} {path}.html /index.html
		file_server

		# Caching: Vite's content-hashed assets never change under the same name, so they may be
		# cached forever; everything else (index.html, favicons) must revalidate each load via the
		# ETag, so a deploy is visible on the next refresh. Without this, browsers cache the SPA
		# heuristically and keep showing a stale build after upgrades. `?` = set only if unset.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
	}

	# Defence-in-depth headers. The CSP is also baked into index.html (build-time) as a fallback for
	# hosts that don't set headers; the header here is authoritative when present.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}
