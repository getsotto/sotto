# Sotto production deployment - copy to deploy/.env and fill in.
#   cp .env.example .env
# .env is gitignored; never commit it.

# The domain the instance is served from (web app + API, one origin). An A/AAAA record must
# point at this host before starting - Caddy provisions the HTTPS certificate automatically.
SOTTO_DOMAIN=app.example.com

# Deployment identity exposed by GET /server/info. Stripe credentials require cloud; leave this
# self_hosted for a customer-operated instance without Stripe, or set cloud for the operated Sotto
# service.
SOTTO_DEPLOYMENT_MODE=self_hosted

# Human hosted action checks are shadow-only by default. Keep this unset until the Cloud
# transition/export gates are approved and rehearsed; set to 1 only during an explicit rollout.
# SOTTO_CLOUD_ACTION_ENFORCEMENT=1
# Coverage authority stays dark until the scheduled revalidation queue has been exercised in a
# pinned-version rehearsal. Shadow informs the rollout without changing responses.
SOTTO_PROVIDER_AUTHORITY_REVALIDATION_ENABLED=0
SOTTO_CLOUD_COVERAGE_AUTHORITY_MAX_AGE_SECONDS=
SOTTO_CLOUD_COVERAGE_AUTHORITY_SHADOW=0
SOTTO_CLOUD_COVERAGE_AUTHORITY_ENFORCEMENT=0

# Hosted machine-token eligibility is dormant until the CI policy and legacy-token inventory are
# approved; self-hosted machine access remains independent of Cloud billing.
# SOTTO_MACHINE_ELIGIBILITY_ENFORCEMENT=1

# New hosted purchases are off by default. Enabling requires cloud mode, all Stripe credentials,
# all four hosted prices, and approved launch terms. It does not disable billing management,
# cancellation, refund processing, or verified webhooks.
SOTTO_CLOUD_SALES_ENABLED=0

# Founding prices stay hidden unless the durable Stripe transition worker is opted in.
# Enable only after the founding interval policy, safe Customer Portal configuration, and pinned
# Stripe schedule flow have passed the test-mode rehearsal. This worker does not enable Cloud sales
# by itself; its paired preflight flag must also be acknowledged.
SOTTO_FOUNDING_SCHEDULE_WORKER_ENABLED=0
SOTTO_FOUNDING_SCHEDULE_PREFLIGHT_VERIFIED=0
SOTTO_FOUNDING_PRICE_NOTICES_ENABLED=0

# Optional, verified Cloud lifecycle email contacts. Both default-off gates must be enabled
# together. The hosted sender uses Resend's transactional email API; set these
# only after the sender domain and delivery runbook are ready. Self-hosted deployments need none.
SOTTO_CLOUD_CONTACT_ENROLMENT_ENABLED=0
SOTTO_CLOUD_CONTACT_EMAIL_SEND_ENABLED=0
SOTTO_CLOUD_CONTACT_EMAIL_FROM=
RESEND_API_KEY=
SOTTO_CLOUD_NOTICE_DISPATCH_ENABLED=0
RESEND_WEBHOOK_SECRET=

# Restart-safe recovery for interrupted hosted billing operations. Keep off until the pinned
# Stripe rehearsal and operator review are complete; it never enables new sales by itself.
SOTTO_BILLING_RECOVERY_WORKER_ENABLED=0
SOTTO_SPONSORED_BILLING_RECOVERY_WORKER_ENABLED=0

# Personal Cloud expiry candidate review is non-destructive and default-off. It only snapshots
# explicit personal scope and records dry-run results; it never deletes data or enables purge.
SOTTO_CLOUD_RETENTION_DRY_RUN_ENABLED=0
# Shared organisation expiry candidates have an independent, default-off scanner and dry-run.
SOTTO_CLOUD_SHARED_RETENTION_DRY_RUN_ENABLED=0
# Dedicated protected operator token. Generate at least 32 characters with `openssl rand -hex 32`.
SOTTO_CLOUD_RETENTION_OPERATOR_TOKEN=
# Destructive execution is separately gated and requires evidence signed by the restore rehearsal.
SOTTO_CLOUD_RETENTION_PURGE_ENABLED=0
SOTTO_CLOUD_RETENTION_DESTRUCTIVE_TOKEN=
SOTTO_CLOUD_RETENTION_EVIDENCE_HMAC_KEY=
# Runtime identity must match the commit SHA embedded when the server binary was built.
SOTTO_CLOUD_RETENTION_BUILD_SHA=
# For source builds, pass this commit SHA as a Docker build argument. Published server images
# embed the workflow's GitHub commit automatically.
SOTTO_BUILD_SHA=

# Payer-transfer quote and consent routes remain unavailable until provider execution and restart
# recovery are deployed and verified. This never enables Stripe work on its own.
SOTTO_BILLING_TRANSFERS_ENABLED=0
SOTTO_BILLING_TRANSFER_EXECUTION_ENABLED=0
SOTTO_BILLING_TRANSFER_SETUP_ENABLED=0

# Protected manual-review controls for payer transfers are only mounted when this separate
# operator token is configured. Resume retries worker verification; recorded invoice-period
# mismatches are re-parked and never accepted by resume. The operator label is caller-supplied audit
# text, not an authenticated identity; this token is shared, so use per-operator tokens if multiple
# people need access. Keep unset until transfer recovery is staffed.
# Generate a 32-character-or-longer value with: openssl rand -hex 32
SOTTO_BILLING_TRANSFER_OPERATOR_TOKEN=

# Postgres password for the internal database (not exposed outside the compose network).
# It is interpolated into DATABASE_URL, so keep it URL-safe: letters and digits, e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# GitHub OAuth app for login. Create one at github.com → Settings → Developer settings →
# OAuth Apps, with the authorization callback URL:
#   https://<SOTTO_DOMAIN>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe billing (optional; requires SOTTO_DEPLOYMENT_MODE=cloud - leave blank for self-hosted).
# From the Stripe dashboard: the secret API key, the signing secret of a webhook endpoint
# pointed at https://<SOTTO_DOMAIN>/billing/webhook (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted), and the Price id of the
# monthly Team subscription.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Hosted personal and sponsored catalogue. Keep every value blank until the Stripe sandbox
# contract is complete and the production price ids are reviewed. Sales remain disabled unless
# SOTTO_CLOUD_SALES_ENABLED=1.
STRIPE_STANDARD_MONTHLY_PRICE_ID=
STRIPE_STANDARD_ANNUAL_PRICE_ID=
STRIPE_FOUNDING_MONTHLY_PRICE_ID=
STRIPE_FOUNDING_ANNUAL_PRICE_ID=
# Stripe Customer Portal configuration: allow payment-method updates and period-end cancellation
# for subscriptions without a schedule; disable subscription updates. Required when hosted sales
# or the founding schedule worker are enabled. A scheduled founder also needs Sotto cancellation.
STRIPE_CLOUD_PORTAL_CONFIGURATION_ID=
SOTTO_SPONSORED_BILLING_ENABLED=0
SOTTO_BILLING_CORRECTIONS_ENABLED=0
# Separate bearer token for the operator-only refund/correction routes. Never reuse the metrics
# token; leave blank until the support and refund procedure has been rehearsed.
SOTTO_BILLING_OPERATOR_TOKEN=

# Provider coverage has separate ingest, worker and reconciliation controls. Keep each disabled
# until the corresponding operational rehearsal is complete.
SOTTO_PROVIDER_REFRESH_INGEST_ENABLED=0
SOTTO_PROVIDER_REFRESH_WORKER_ENABLED=0
SOTTO_PROVIDER_REFRESH_RECONCILIATION_ENABLED=0
# Required only when enabling personal Stripe coverage ingestion or its worker.
STRIPE_ACCOUNT_ID=

# Build-time release switch for staged hosted pricing copy. It does not enable server-side sales.
VITE_CLOUD_PRICING_VISIBLE=false

# Telemetry (optional). The server sends one anonymous ping a day - a random instance uuid,
# its version, and os/arch, nothing else (see the README's Telemetry section for the exact
# payload and crates/server/src/telemetry.rs for the code). Set to "off" to disable.
SOTTO_TELEMETRY=

# Landing-page GitHub stats (stars, forks, contributors). Ships off: GET /community returns
# 503 unless set to 1, so a self-hosted server never calls api.github.com. Set to 1 on the
# public marketing instance.
SOTTO_COMMUNITY=

# Organisation deletion recovery window for new requests, in days (1-365, default: 30). Match this
# to the managed-backup and export lifecycle. The organisation stays frozen for the whole window.
# Existing operations keep their stored purge deadline.
SOTTO_ORGANISATION_DELETION_RETENTION_DAYS=30

# Organisation deletion ships off. The exact value 1 enables both the lifecycle worker and the
# owner-facing deletion routes; any other value leaves them unreachable. Work through
# README.md "Enabling organisation deletion" before changing this - deletion is irreversible once
# purge begins. The web flag below is compiled into source builds with --build.
SOTTO_ORGANISATION_DELETION_WORKER_ENABLED=0
# Optional protected Prometheus scrape token. Leave blank until the metrics dashboard is ready;
# generate a separate random value per deployment with: openssl rand -hex 32
SOTTO_ORGANISATION_DELETION_METRICS_TOKEN=
# Optional protected operator token for recording audited billing observations. Keep this
# separate from the metrics token and leave blank until the operator runbook is ready.
SOTTO_ORGANISATION_DELETION_OPERATOR_TOKEN=
# Optional protected aggregate Cloud lifecycle scrape credential. This is read-only and must not
# be reused for notice, transfer, retention, deletion, or coverage-repair operations.
SOTTO_CLOUD_OPERATIONS_METRICS_TOKEN=
# Optional dedicated credential for Stripe-backed coverage repair; leave blank until the private
# operator procedure and alerting are ready. It cannot approve refunds or retention purges.
SOTTO_CLOUD_COVERAGE_REPAIR_TOKEN=
VITE_ORGANISATION_DELETION_ENABLED=false

# Off-box backups (strongly recommended): where deploy/backup.sh ships nightly verified
# dumps. The scheme picks the tool - gs://bucket (gsutil), s3://bucket (aws cli), or any
# rclone remote:path (B2, SFTP, a NAS, …). Setup + cron + restore: deploy/README.md § Backups.
SOTTO_BACKUP_BUCKET=
