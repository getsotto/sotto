def e(text) -> str:
    # Explicitly None rather than falsy: a legitimate 0 or False is a value to show, and
    # `text or ""` would silently render it as nothing.
    return html.escape("" if text is None else str(text))


def bar_class(tally) -> str:
    if tally is None:
        return "none"
    if tally["ok"] == tally["total"]:
        return ""
    return "down" if tally["ok"] == 0 else "partial"


def bar_style(tally) -> str:
    """A partial day drawn in proportion, not as a fixed half.

    One failure in ten and nine in ten are different days, and a 50/50 gradient tells the
    reader they were the same. The share of the bar that is red is the share of the checks
    that failed.
    """
    if tally is None or tally["ok"] == tally["total"] or tally["ok"] == 0:
        return ""
    failed = 100.0 * (tally["total"] - tally["ok"]) / tally["total"]
    return (f' style="background: linear-gradient(var(--alert) {failed:.0f}%,'
            f' var(--ok) {failed:.0f}%)"')


def bar_title(slot) -> str:
    tally = slot["tally"]
    if tally is None:
        return f"{slot['date']}: not checked"
    return f"{slot['date']}: {tally['ok']} of {tally['total']} checks passed"


def render_component(row: dict) -> str:
    bars = "".join(
        f'<div class="bar {bar_class(s["tally"])}"{bar_style(s["tally"])}'
        f' title="{e(bar_title(s))}"></div>'
        for s in row["slots"]
    )
    if row["uptime"]:
        up = row["uptime"]
        # The denominator is not decoration. At the cadence this actually achieves, "100%" can
        # rest on a handful of observations, and a reader who cannot see how many is being
        # invited to trust a number nobody could stand behind.
        summary = (f'{up["percent"]:.2f}% of {up["total"]} '
                   f'{"check" if up["total"] == 1 else "checks"}')
        percent_label = f'{up["percent"]:.2f}% uptime'
    else:
        summary = "not measured"
        percent_label = "not measured"

    lines = [row["description"], row["detail"]]
    described = "".join(f'\n            <p class="desc">{e(line)}</p>' for line in lines if line)
    state_label = STATE_LABELS.get(row["state"], row["state"])

    return f"""      <section class="component">
        <div class="component-head">
          <div class="component-title">
            <h3>{e(row["name"])}</h3>{described}
          </div>
          <div class="component-meta">
            <span class="uptime">{e(percent_label)}</span>
            <span class="state"><span class="dot {e(row["state"])}"></span> {e(state_label)}</span>
          </div>
        </div>
        <div class="bars" role="img"
             aria-label="{e(row["name"])}: {e(summary)} over the last 90 days">{bars}</div>
        <div class="scale"><span>90 days ago</span><span class="scale-summary">{e(summary)}</span><span>Today</span></div>
      </section>
"""


def render_incident(incident: dict) -> str:
    updates = "".join(
        f'          <div class="update"><time>{e(u["at"])}</time><p class="update-body">{e(u["body"])}</p></div>\n'
        for u in incident["updates"]
    )
    timeline = f'        <div class="timeline">\n{updates}        </div>\n' if updates else ""
    return f"""      <article class="incident">
        <div class="incident-header">
          <div class="incident-title-row">
            <h3><a href="{e(incident["url"])}">{e(incident["title"])}</a></h3>
            <span class="stage-badge stage-{e(incident["stage"])}">{e(incident["stage"])}</span>
          </div>
          <p class="meta">Opened {e(incident["opened"])}</p>
        </div>
{timeline}      </article>
"""


def favicon_link(source: pathlib.Path = FAVICON_SOURCE) -> str:
    """The icon as a `<link>` carrying its own bytes, or an empty string if it cannot be read.

    Degrades rather than failing. An icon is decoration, and refusing to publish a status page
    because a decorative file moved would take the page down over the one thing it is not about,
    on a day when the page is quite possibly the only thing still working. The warning goes to
    stderr so a build that quietly lost the icon still says so.
    """
    try:
        svg = source.read_bytes()
    except OSError as error:
        print(
            f"no icon at {source} ({type(error).__name__}); the page will have none",
            file=sys.stderr,
        )
        return ""
    inline = base64.b64encode(svg).decode("ascii")
    return f'<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,{inline}">'


def render(model: dict, now: dt.datetime) -> str:
    components = "".join(render_component(r) for r in model["rows"])
    if model.get("incidents_unavailable"):
        incidents = ('      <div class="notice-card alert">\n'
                     '        <p class="desc">The incident log could not be read when this page '
                     'was built, so it is not shown. That is not the same as there being '
                     'none.</p>\n      </div>\n')
    elif model["incidents"]:
        incidents = "".join(render_incident(i) for i in model["incidents"])
    else:
        incidents = ('      <div class="empty-incidents-card">\n'
                     '        <div class="empty-icon-wrap" aria-hidden="true">\n'
                     '          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">\n'
                     '            <polyline points="20 6 9 17 4 12"></polyline>\n'
                     '          </svg>\n'
                     '        </div>\n'
                     '        <div>\n'
                     '          <strong>All systems clear</strong>\n'
                     '          <p class="desc">No incidents in the last 90 days. Anything still '
                     'open is listed however old it is.</p>\n'
                     '        </div>\n'
                     '      </div>\n')
    if model.get("truncated"):
        # Only reachable if there are more incidents in the window than the fetch asked for.
        # Saying so beats a list that is quietly short: this page is worth exactly as much as
        # its worst unstated omission.
        incidents += ('      <div class="notice-card muted">\n'
                      '        <p class="desc">More incidents matched than this page fetched, so '
                      'the list above is incomplete.</p>\n      </div>\n')

    cadences = [r["cadence"] for r in model["rows"] if r["cadence"]]
    if cadences:
        per_day = sum(cadences) / len(cadences)
        # Said plainly rather than as an interval. The collector asks for one every ten minutes
        # and does not get it, so a promised cadence here would be a number this page made up.
        sampling = (f"Uptime is sampled, not measured continuously: about "
                    f"{per_day:.0f} {'check' if round(per_day) == 1 else 'checks'} a day per "
                    f"component so far. A day nobody checked is shown blank rather than green.")
    else:
        sampling = "No checks have been recorded yet."

    checked_meta = f'Last checked {e(model["generated_at"])}' if model.get("generated_at") else ""

    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Sotto status</title>
{favicon_link()}
<style>{STYLE}</style>
</head>
<body>
<main>
  <header class="masthead">
    <a href="https://getsotto.co.uk" class="wordmark">Sotto</a>
    <nav aria-label="Site">
      <a href="https://getsotto.co.uk">Home</a>
      <a href="https://github.com/getsotto/sotto">GitHub</a>
    </nav>
  </header>

  <div class="page-intro">
    <h1>Sotto status</h1>
    <p class="meta">{checked_meta}</p>
  </div>

  <div class="banner {e(model["tone"])}">
    <div class="banner-main">
      <span class="dot-wrapper"><span class="dot {e(model["tone"])}"></span></span>
      <strong>{e(model["banner"])}</strong>
    </div>
    <span class="banner-meta">{checked_meta}</span>
  </div>

  <section class="section-block">
    <h2>Components</h2>
    <div class="components-card">
{components}    </div>
  </section>

  <section class="section-block">
    <h2>Past incidents</h2>
{incidents}  </section>

  <footer>
    <nav aria-label="Footer">
      <a href="https://getsotto.co.uk">Home</a>
      <a href="https://github.com/getsotto/sotto">GitHub</a>
      <a href="https://github.com/getsotto/sotto/releases">Releases</a>
      <a href="https://github.com/getsotto/sotto/blob/main/SECURITY.md">Security</a>
      <a href="https://github.com/getsotto/sotto/blob/main/THREAT-MODEL.md">Threat model</a>
    </nav>
    <p>{e(sampling)}</p>
    <p>This page is built from the checks in
       <a href="https://github.com/getsotto/sotto">getsotto/sotto</a> and published separately
       from the service it reports on, so it survives the service being gone.
       Built {e(now.strftime("%Y-%m-%dT%H:%M:%SZ"))}.</p>
  </footer>
</main>
</body>
</html>
"""


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--summary", required=True)
    parser.add_argument("--incidents")
    parser.add_argument("--incidents-unavailable", action="store_true",
                        help="the incident log could not be read. Say so on the page rather "
                             "than rendering the absence of data as an absence of incidents")
    parser.add_argument("--fetch-limit", type=int, default=0,
                        help="the incident budget. Fetch one more than this and hand the "
                             "surplus over, so an overflowing list is reported as incomplete "
                             "rather than silently short")
    parser.add_argument("--out", required=True)
    args = parser.parse_args()

    with open(args.summary, encoding="utf-8") as f:
        summary = json.load(f)
    issues = []
    if args.incidents and os.path.exists(args.incidents):
        with open(args.incidents, encoding="utf-8") as f:
            issues = json.load(f)

    now = dt.datetime.now(dt.timezone.utc)
    truncated = possibly_truncated(issues, args.fetch_limit)
    model = build(summary, issues, now.date(), truncated)
    model["incidents_unavailable"] = args.incidents_unavailable
    page = render(model, now)
    os.makedirs(args.out, exist_ok=True)
    with open(os.path.join(args.out, "index.html"), "w", encoding="utf-8") as f:
        f.write(page)
    print(f"wrote {os.path.join(args.out, 'index.html')} ({len(page)} bytes)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
