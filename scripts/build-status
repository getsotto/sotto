#!/usr/bin/env python3
"""Render the status page from what the collector recorded and what the incidents say.

Usage: scripts/build-status --summary <summary.json> --incidents <issues.json> --out <dir>

Reads files rather than calling anything, so the shaping below can be tested without a network
and so the page can be rebuilt from an archived pair of inputs to see what it said on a given
day. The workflow does the fetching.

The output is one self-contained file. No scripts, no external assets, no fonts to fail to
load: a status page whose own availability depends on a CDN is a joke told at its own expense,
and Sordino asks that everything degrade to legible text anyway. The icon is inlined for the
same reason, and reused from the web app so the two cannot drift.
"""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import html
import json
import os
import pathlib
import sys

# The window the collector retains, and so the most the page can show.
SPAN_DAYS = 90

# The web app's icon, reused here and inlined rather than linked.
#
# Inlined because this page is served from a different origin to the app: `/favicon.svg` does not
# resolve here, and the absolute URL would have the status page fetch an asset from the service it
# exists to report on, so on the one morning it matters the icon fails along with everything else.
# That is the same reasoning that keeps the fonts and styles in the file.
#
# Read from the app's own copy at build time rather than pasted in, so the two cannot drift and a
# redesign of one is a redesign of both. It is well under a kilobyte, which is cheaper than the
# request it saves.
FAVICON_SOURCE = pathlib.Path(__file__).resolve().parents[1] / "web/public/favicon.svg"

OK, DOWN, UNCONFIGURED = "ok", "down", "unconfigured"

# What the banner says, worst case first. Only probed components vote: a deployment that has
# chosen not to run billing is not having a billing outage.
OPERATIONAL = ("All systems operational", "ok")
PARTIAL = ("Some systems are down", "down")
MAJOR = ("Major outage", "down")
UNKNOWN = ("Status unknown", "unknown")

STATE_LABELS = {
    OK: "Operational",
    DOWN: "Outage",
    UNCONFIGURED: "Unconfigured",
}


def overall(components: list[dict]) -> tuple[str, str]:
    measured = [c for c in components if c.get("state") in (OK, DOWN)]
    if not measured:
        # Nothing has been observed at all, which is not the same as everything being fine and
        # must never be reported as it.
        return UNKNOWN
    down = [c for c in measured if c["state"] == DOWN]
    if not down:
        return OPERATIONAL
    return MAJOR if len(down) == len(measured) else PARTIAL


def within_window(days: list[dict], today: dt.date, span: int = SPAN_DAYS) -> list[dict]:
    """The days the page can actually show.

    Everything derived from the history has to agree on this. The collector trims against its
    own clock, so a page built later inherits days that have since fallen out of its window;
    left alone, the bars drop them and the percentage keeps counting them, and a component with
    one green bar reports nine per cent. Whatever a reader can see has to be what the number
    was made from.
    """
    horizon = (today - dt.timedelta(days=span - 1)).isoformat()
    return [d for d in days if d["date"] >= horizon]


def day_slots(days: list[dict], today: dt.date, span: int = SPAN_DAYS) -> list[dict]:
    """One slot per day across the window, oldest first.

    A day with no samples is `None`, never zero and never full. The distinction is the whole
    point: a day nobody checked is not a day that was down, and it is not a day that was up.
    Rendering it as either invents history.
    """
    tallies = {d["date"]: d for d in days}
    slots = []
    for offset in range(span - 1, -1, -1):
        date = (today - dt.timedelta(days=offset)).isoformat()
        tally = tallies.get(date)
        slots.append({"date": date, "tally": tally})
    return slots


def uptime(days: list[dict]) -> dict | None:
    """Checks passed out of checks made, with the denominator kept.

    A bare percentage would be the dishonest form here. The collector's cadence is whatever
    GitHub's scheduler grants it, so "100%" can mean four observations, and a reader deserves
    to see which.
    """
    total = sum(d["total"] for d in days)
    if total == 0:
        return None
    ok = sum(d["ok"] for d in days)
    return {"ok": ok, "total": total, "percent": 100.0 * ok / total}


def observed_cadence(days: list[dict], today: dt.date) -> float | None:
    """Checks per day, measured rather than promised.

    The collector asks to run every ten minutes and does not: scheduled workflows are queued,
    not guaranteed. Whatever the page says about how often it looks has to come from the data.

    The denominator is every day since the first sample, not the days that happen to have one.
    Counting only active days is the flattering error: two bursts a month apart would report
    the same healthy "two checks a day" as two consecutive days, because the empty month
    between them would not be in the divisor. Days since the first sample rather than the whole
    window, because a collector three days old has not missed eighty-seven days, it has not
    lived through them.
    """
    if not days:
        return None
    first = dt.date.fromisoformat(min(d["date"] for d in days))
    elapsed = max((today - first).days + 1, 1)
    return sum(d["total"] for d in days) / elapsed


def opened_at(item: dict) -> str:
    return item.get("createdAt") or item.get("created_at") or ""


def parse_incidents(issues: list[dict], today: dt.date, span: int = SPAN_DAYS) -> list[dict]:
    """GitHub issues as incidents, newest first.

    Chosen because at three in the morning, on a phone, opening an issue and adding comments is
    realistic and committing files is not. The authoring path has to be the easiest available or
    the log stops being written exactly when it matters.

    Scoped to the same window as the bars, because that is what the rest of the page is about,
    with one exception that matters more than the rule: an incident still open is shown however
    old it is. Ageing out an ongoing outage would be the single worst thing this page could do.
    """
    horizon = (today - dt.timedelta(days=span - 1)).isoformat()
    incidents = []
    for issue in issues:
        # `gh` spells this CLOSED and the REST API spells it closed, and comparing against one
        # of them silently gets the other wrong in the worst direction: a resolved incident
        # renders as still under investigation and never ages out of the log.
        closed = str(issue.get("state", "")).lower() == "closed"
        # Kept if anything about it happened inside the window: it opened here, or it ended
        # here. A long outage that began before the window and was resolved inside it is
        # exactly the kind the bars will be showing, and dropping it on its opening date alone
        # would leave the log silent about the days the bars are red.
        ended = (issue.get("closedAt") or issue.get("closed_at") or "")[:10]
        within = opened_at(issue)[:10] >= horizon or (ended and ended >= horizon)
        if closed and not within:
            continue
        labels = [l["name"] for l in issue.get("labels", [])]
        # `resolved` is deliberately not readable from a label. Closing the issue is what
        # resolves an incident, so an open issue wearing a stale `resolved` label would
        # otherwise be published as over while it was still happening.
        stage = next((s for s in ("monitoring", "identified", "investigating") if s in labels),
                     None)
        updates = sorted(issue.get("comments", []), key=opened_at)
        incidents.append({
            "title": issue.get("title", "Untitled incident"),
            "url": issue.get("url") or issue.get("html_url", ""),
            "stage": "resolved" if closed else (stage or "investigating"),
            "opened": opened_at(issue)[:10],
            # Sorted on the full timestamp, not the date. Two incidents on one bad day are
            # exactly when the order matters and exactly when a date-only sort gives up.
            "sort_key": opened_at(issue),
            "updates": [
                {"at": opened_at(c)[:16].replace("T", " "), "body": c.get("body", "").strip()}
                for c in updates
            ],
        })
    incidents.sort(key=lambda i: i["sort_key"], reverse=True)
    return incidents


def possibly_truncated(issues: list[dict], budget: int) -> bool:
    """Whether the fetch could have cut an incident the page would otherwise show.

    Asked by fetching one more than the budget, so a full page and an overflowing one are
    distinguishable without guessing. `len(issues) >= budget` cannot tell them apart and cries
    wolf on a list that is merely exactly the budget long.

    An earlier version tried to be cleverer, ignoring a full fetch when everything in it opened
    before the window on the grounds that nothing displayable had been lost. That reasoning
    died the moment incidents began qualifying by when they were resolved rather than when they
    opened: an incident opened in 2010 and closed yesterday belongs on this page, so no cutoff
    on the opening date can rule anything out. The narrow question has no cheap answer, and the
    blunt one does.
    """
    return bool(budget) and len(issues) > budget


def build(summary: dict, issues: list[dict], today: dt.date, truncated: bool = False) -> dict:
    components = summary.get("components", [])
    banner, tone = overall(components)
    rows = []
    for component in components:
        days = within_window(component.get("days", []), today)
        rows.append({
            "name": component.get("name") or component.get("id") or "Unnamed",
            "description": component.get("description", ""),
            "state": component.get("state", UNCONFIGURED),
            "detail": component.get("detail"),
            "slots": day_slots(days, today),
            "uptime": uptime(days),
            "cadence": observed_cadence(days, today),
        })
    return {
        "banner": banner,
        "tone": tone,
        "generated_at": summary.get("generated_at"),
        "rows": rows,
        "incidents": parse_incidents(issues, today),
        "truncated": truncated,
        "span": SPAN_DAYS,
    }


