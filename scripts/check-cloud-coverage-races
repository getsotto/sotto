#!/usr/bin/env python3
"""Run the bounded cloud coverage race scenarios with real local Postgres."""

from __future__ import annotations

import argparse
from concurrent.futures import ThreadPoolExecutor
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
from urllib.parse import urlsplit


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_TIMEOUT = 120
# Bounded wait between SIGTERM and SIGKILL when a command exceeds its timeout.
KILL_GRACE_SECONDS = 5.0
KILL_POLL_SECONDS = 0.025
SCENARIOS = (
    ("cloud_coverage_reconciliation", "registration_rejects_complete_publication_before_coordinator_lock"),
    ("cloud_coverage_reconciliation", "registration_rejects_complete_publication_after_revision_anchor"),
    ("cloud_coverage_reconciliation", "competing_source_claims_preserve_provider_allocation_ownership"),
    ("cloud_coverage_reconciliation", "completion_first_allows_registration_and_preserves_historical_replay"),
    ("cloud_coverage_reconciliation", "superseded_finish_waits_for_a_pending_replacement"),
    ("cloud_coverage_reconciliation", "superseded_finish_waits_for_a_completing_replacement"),
    ("cloud_coverage_store", "competing_corrections_serialize_on_the_head_and_reject_the_loser"),
    ("cloud_coverage_store", "simultaneous_first_publications_have_one_winner"),
    ("cloud_coverage_store", "scenario_panic_cleans_owned_publication_fixture"),
    ("cloud_coverage_store", "setup_failure_after_insert_cleans_the_registered_fixture"),
    ("cloud_coverage_store", "readiness_timeout_cancels_a_parked_publication_before_cleanup"),
)


def validate_database(env: dict[str, str]) -> None:
    if env.get("SOTTO_RUN_DB_TESTS") != "1":
        raise ValueError("race runner requires SOTTO_RUN_DB_TESTS=1")
    try:
        url = urlsplit(env.get("DATABASE_URL", ""))
        valid = (
            url.scheme in ("postgres", "postgresql")
            and url.hostname in ("localhost", "127.0.0.1", "::1")
            and len(url.path) > 1
            and not url.query
            and not url.fragment
        )
    except ValueError:
        valid = False
    if not valid:
        raise ValueError(
            "race runner requires a local disposable PostgreSQL DATABASE_URL without query parameters"
        )


def emit(value: str | bytes | None, stream: object) -> None:
    if value:
        if isinstance(value, bytes):
            value = value.decode(errors="replace")
        print(value, end="", file=stream)


def spawn_owned(args: list[str], env: dict[str, str]) -> subprocess.Popen[bytes]:
    """Start a command in its own process group so timeouts can own the whole tree."""
    if os.name == "nt":
        return subprocess.Popen(
            args,
            cwd=ROOT,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            creationflags=subprocess.CREATE_NEW_PROCESS_GROUP,
        )
    return subprocess.Popen(
        args,
        cwd=ROOT,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )


def group_exited(pgid: int) -> bool:
    """Check whether a POSIX process group has no members left.

    A group whose members are all zombies reports PermissionError on some
    platforms instead of ProcessLookupError; treat that as still present and
    let the signal step below tolerate it.
    """
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False
    return False


def signal_group(pgid: int, signum: int) -> None:
    """Signal a private process group, tolerating zombies and races.

    Every member of our own session group runs as our user, so PermissionError
    can only come from already-dead members that some platforms refuse to
    signal; they need no further action.
    """
    try:
        os.killpg(pgid, signum)
    except (ProcessLookupError, PermissionError):
        pass


def wait_for_group_exit(proc: subprocess.Popen[bytes], pgid: int, deadline: float) -> bool:
    while time.monotonic() < deadline:
        # Reap the direct child while waiting so its zombie never masks group state.
        proc.poll()
        if group_exited(pgid):
            return True
        time.sleep(KILL_POLL_SECONDS)
    proc.poll()
    return group_exited(pgid)


def terminate_tree(proc: subprocess.Popen[bytes]) -> None:
    """Terminate a timed-out command and all descendants, then escalate to a hard kill."""
    if os.name == "nt":
        terminate_tree_windows(proc)
        return
    try:
        pgid = os.getpgid(proc.pid)
    except ProcessLookupError:
        return
    # Reap an already-exited direct child so its zombie does not mask group state.
    proc.poll()
    if not group_exited(pgid):
        signal_group(pgid, signal.SIGTERM)
    if wait_for_group_exit(proc, pgid, time.monotonic() + KILL_GRACE_SECONDS):
        return
    if not group_exited(pgid):
        signal_group(pgid, signal.SIGKILL)
    wait_for_group_exit(proc, pgid, time.monotonic() + KILL_GRACE_SECONDS)


def terminate_tree_windows(proc: subprocess.Popen[bytes]) -> None:
    """Best-effort whole-tree termination on Windows without extra dependencies."""
    try:
        subprocess.run(
            ["taskkill", "/pid", str(proc.pid), "/T", "/F"],
            capture_output=True,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        pass
    if proc.poll() is None:
        try:
            proc.terminate()
        except OSError:
            pass
    try:
        proc.wait(timeout=KILL_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        if proc.poll() is None:
            try:
                proc.kill()
            except OSError:
                pass


def run(
    args: list[str],
    env: dict[str, str],
    timeout_seconds: int,
    label: str | None = None,
) -> subprocess.CompletedProcess[str]:
    """Run one command, owning its process tree, and return captured text output."""
    tag = label or " ".join(args)
    print("+", " ".join(args), flush=True)
    proc = spawn_owned(args, env)
    try:
        raw_stdout, raw_stderr = proc.communicate(timeout=timeout_seconds)
    except subprocess.TimeoutExpired as error:
        terminate_tree(proc)
        raw_stdout, raw_stderr = proc.communicate()
        stdout = (raw_stdout or b"").decode(errors="replace")
        stderr = (raw_stderr or b"").decode(errors="replace")
        emit(stdout, sys.stdout)
        emit(stderr, sys.stderr)
        raise RuntimeError(f"{tag}: timed out after {timeout_seconds}s") from error
    stdout = (raw_stdout or b"").decode(errors="replace")
    stderr = (raw_stderr or b"").decode(errors="replace")
    if proc.returncode:
        emit(stdout, sys.stdout)
        emit(stderr, sys.stderr)
        raise RuntimeError(f"{tag}: command exited {proc.returncode}")
    emit(stdout, sys.stdout)
    emit(stderr, sys.stderr)
    return subprocess.CompletedProcess(args, proc.returncode or 0, stdout, stderr)


def discover(target: str, env: dict[str, str], timeout_seconds: int) -> set[str]:
    result = run(
        ["cargo", "test", "-p", "sotto-server", "--test", target, "--", "--list"],
        env,
        timeout_seconds,
    )
    return {
        line.split(":", 1)[0]
        for line in result.stdout.splitlines()
        if line.endswith(": test")
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--rounds", type=int, default=5)
    parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    parsed = parser.parse_args()
    if parsed.rounds < 1 or parsed.timeout < 1:
        parser.error("rounds and timeout must be positive")

    env = os.environ.copy()
    try:
        validate_database(env)
        targets = {target for target, _ in SCENARIOS}
        discovered = {target: discover(target, env, parsed.timeout) for target in targets}
        missing = [
            f"{target}::{name}"
            for target, name in SCENARIOS
            if name not in discovered[target]
        ]
        if missing:
            raise RuntimeError("scenario discovery failed: " + ", ".join(missing))

        for target, name in SCENARIOS:
            run(
                [
                    "cargo", "test", "-p", "sotto-server", "--test", target,
                    name, "--", "--exact", "--nocapture", "--test-threads=4",
                ],
                env,
                parsed.timeout,
            )
        for round_number in range(1, parsed.rounds + 1):
            print(f"race repetition round {round_number}/{parsed.rounds}", flush=True)
            commands = [
                [
                    "cargo", "test", "-p", "sotto-server", "--test", target,
                    "--", "--test-threads=4",
                ]
                for target in sorted(targets)
            ]
            with ThreadPoolExecutor(max_workers=len(commands)) as executor:
                futures = [
                    executor.submit(run, command, env, parsed.timeout)
                    for command in commands
                ]
                failures = []
                for future in futures:
                    try:
                        future.result()
                    except Exception as error:  # noqa: BLE001 - preserve every subprocess failure
                        failures.append(str(error))
                if failures:
                    raise RuntimeError(
                        "parallel target failures:\n" + "\n".join(f"- {failure}" for failure in failures)
                    )
    except (OSError, ValueError, RuntimeError) as error:
        print(f"cloud coverage race checks failed: {error}", file=sys.stderr)
        return 1
    print(f"cloud coverage race checks passed: {len(SCENARIOS)} scenarios x {parsed.rounds} rounds")
    return 0


if __name__ == "__main__":
    sys.exit(main())
