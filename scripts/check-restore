#!/usr/bin/env python3
"""Assert that a restored Sotto database is one you could actually run on.

Usage: scripts/check-restore --database-url <url> [--migrations <dir>]

This is the 2026-08-31 restore rehearsal written down as code. `backup.sh` already validates
each archive with `pg_restore --list` before upload, so what it cannot tell you is whether the
bytes survived the trip and whether what comes back matches the schema this repository builds.
Those are the two questions here.

Nothing it prints contains data. The repository is public, so its workflow logs are public, and
a restored dump is production: counts, table names and migration versions are safe to say out
loud, and nothing else is worth the risk of saying by accident.
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import urllib.parse

# Tables whose emptiness would mean the dump restored but carried nothing worth restoring.
# A backup of the wrong database, or of one truncated before the dump, passes every structural
# check ever written and fails this one.
MUST_NOT_BE_EMPTY = ("users", "organizations")

# The deletion tables, named because they are why restores are verified at all: organisation
# deletion is the one operation in Sotto that cannot be undone from inside the product, so the
# backup is the only thing standing behind it.
MUST_EXIST = (
    "organization_deletions",
    "organization_deletion_metric_counters",
    "audit_events",
    "cloud_retention_tombstone_journal",
)

MIGRATIONS_TABLE = "_sqlx_migrations"


def connection_env(url: str) -> dict[str, str]:
    """A connection URL taken apart into the variables psql reads from the environment.

    The password never becomes an argument. Two things go wrong when it does, and both matter
    more here than the throwaway credential this job happens to use: argv is world readable on
    the host, so `ps` hands the password to any local user, and a failed command raises a
    `CalledProcessError` whose text is the argument list, which on a public runner writes it
    into a log that is public for ever. This script is documented for running by hand against a
    scratch database on a real host, where the password would be a real one.
    """
    parts = urllib.parse.urlsplit(url)
    env = dict(os.environ)
    env["PGHOST"] = parts.hostname or "localhost"
    env["PGDATABASE"] = parts.path.lstrip("/")
    if parts.port:
        env["PGPORT"] = str(parts.port)
    if parts.username:
        env["PGUSER"] = urllib.parse.unquote(parts.username)
    if parts.password:
        env["PGPASSWORD"] = urllib.parse.unquote(parts.password)
    return env


class Database:
    """A psql that returns one column of rows, so the checks below can be tested without one."""

    def __init__(self, url: str):
        self.env = connection_env(url)

    def rows(self, sql: str) -> list[str]:
        result = subprocess.run(
            ["psql", "-At", "-v", "ON_ERROR_STOP=1", "-c", sql],
            capture_output=True,
            text=True,
            check=True,
            env=self.env,
        )
        return [line for line in result.stdout.splitlines() if line != ""]


def repository_migrations(directory: str) -> list[str]:
    """The migration versions this checkout builds, as sqlx numbers them: the digits leading
    each filename."""
    versions = []
    for name in sorted(os.listdir(directory)):
        match = re.match(r"^(\d+)_.*\.sql$", name)
        if match:
            versions.append(str(int(match.group(1))))
    return versions


def check_migrations(applied: list[tuple[str, str]], repository: list[str]) -> list[str]:
    """Compare what the dump recorded against what this checkout carries.

    Deliberately not an equality test. Production is often a release or two behind `main`, and
    failing every month between a migration merging and the deployment taking it would train
    everyone to ignore this job. What must never happen is the other direction: a dump carrying
    a migration this checkout does not have means the schema and the code have diverged, and
    restoring it would not give you a database this code can run on.
    """
    problems = []
    failed = [version for version, success in applied if success not in ("t", "true", "1")]
    if failed:
        problems.append(f"migrations recorded as failed: {', '.join(sorted(failed))}")

    versions = [version for version, _ in applied]
    if not versions:
        problems.append("the restored database records no migrations at all")

    unknown = sorted(set(versions) - set(repository), key=int)
    if unknown:
        problems.append(
            f"the dump carries migrations this checkout does not: {', '.join(unknown)}; "
            "the deployment is ahead of this branch"
        )
    return problems


def check_tables(present: list[str]) -> list[str]:
    missing = [table for table in MUST_EXIST if table not in present]
    if missing:
        return [f"tables missing from the restored database: {', '.join(missing)}"]
    return []


def check_not_empty(counts: dict[str, int]) -> list[str]:
    empty = sorted(table for table, count in counts.items() if count == 0)
    if empty:
        return [f"tables restored but empty: {', '.join(empty)}"]
    return []


def inspect(db: Database) -> tuple[list[tuple[str, str]], list[str], dict[str, int]]:
    applied = [
        tuple(row.split("|", 1))
        for row in db.rows(f"SELECT version, success FROM {MIGRATIONS_TABLE} ORDER BY version")
    ]
    tables = db.rows(
        "SELECT tablename FROM pg_tables WHERE schemaname = 'public' ORDER BY tablename"
    )
    counts = {}
    for table in MUST_NOT_BE_EMPTY:
        if table in tables:
            counts[table] = int(db.rows(f"SELECT count(*) FROM {table}")[0])
        else:
            counts[table] = 0
    return applied, tables, counts


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--database-url", required=True)
    parser.add_argument("--migrations", default="crates/server/migrations")
    args = parser.parse_args()

    applied, tables, counts = inspect(Database(args.database_url))
    repository = repository_migrations(args.migrations)

    print(f"tables restored: {len(tables)}")
    print(f"migrations applied: {len(applied)} of {len(repository)} in this checkout")
    for table, count in sorted(counts.items()):
        print(f"rows in {table}: {count}")

    problems = (
        check_migrations(applied, repository) + check_tables(tables) + check_not_empty(counts)
    )
    for problem in problems:
        print(f"FAIL: {problem}", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
