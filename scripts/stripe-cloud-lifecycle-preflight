#!/usr/bin/env python3
"""Check a restricted Stripe test key and the four configured Cloud prices without writes."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
from collections.abc import Callable
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import HTTPRedirectHandler, Request, build_opener

SCHEMA = "sotto-stripe-cloud-lifecycle-preflight-v1"
API_BASE = "https://api.stripe.com"
ROOT = Path(__file__).resolve().parents[1]
MAX_RESPONSE_BYTES = 1_048_576
REQUEST_TIMEOUT_SECONDS = 15

OFFERS = {
    "standard_monthly": ("STRIPE_STANDARD_MONTHLY_PRICE_ID", 299, "month"),
    "standard_annual": ("STRIPE_STANDARD_ANNUAL_PRICE_ID", 2999, "year"),
    "founding_monthly": ("STRIPE_FOUNDING_MONTHLY_PRICE_ID", 199, "month"),
    "founding_annual": ("STRIPE_FOUNDING_ANNUAL_PRICE_ID", 1999, "year"),
}


class PreflightError(RuntimeError):
    """A safe, fixed diagnostic that never includes a provider response or secret."""


class RejectStripeRedirects(HTTPRedirectHandler):
    """Reject redirects so requests cannot leave the fixed Stripe API host."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise HTTPError(req.full_url, code, "Stripe API redirects are not permitted", headers, fp)


def server_api_version() -> str:
    try:
        source = (ROOT / "crates/server/src/billing.rs").read_text(encoding="utf-8")
    except OSError as error:
        raise PreflightError("server_api_version_unavailable") from error
    match = re.search(r'pub const STRIPE_API_VERSION: &str = "([0-9]{4}-[0-9]{2}-[0-9]{2}\.[a-z]+)";', source)
    if not match:
        raise PreflightError("server_api_version_invalid")
    return match.group(1)


def fingerprint(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()[:16]


def require_identifier(value: str, pattern: str, error_code: str) -> str:
    if not re.fullmatch(pattern, value):
        raise PreflightError(error_code)
    return value


def read_restricted_key(path_value: str | Path) -> str:
    path = Path(path_value)
    try:
        if not path.is_absolute() or path.is_symlink() or path.parent.is_symlink():
            raise PreflightError("key_file_path_invalid")
        details = path.stat()
        parent_details = path.parent.stat()
        if not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid():
            raise PreflightError("key_file_owner_or_type_invalid")
        if (
            stat.S_IMODE(details.st_mode) & 0o077
            or stat.S_IMODE(parent_details.st_mode) & 0o077
            or parent_details.st_uid != os.getuid()
        ):
            raise PreflightError("key_file_permissions_invalid")
        key = path.read_text(encoding="utf-8").strip()
    except PreflightError:
        raise
    except (OSError, UnicodeError) as error:
        raise PreflightError("key_file_unavailable") from error
    if not key.startswith("rk_test_") or len(key) > 512 or any(ch.isspace() for ch in key):
        raise PreflightError("restricted_test_key_required")
    return key


def stripe_json(path: str, key: str) -> dict:
    request = Request(
        API_BASE + path,
        headers={
            "Authorization": f"Bearer {key}",
            "Stripe-Version": server_api_version(),
            "Accept": "application/json",
            "User-Agent": "sotto-cloud-lifecycle-preflight/1",
        },
        method="GET",
    )
    try:
        opener = build_opener(RejectStripeRedirects())
        with opener.open(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
            raw = response.read(MAX_RESPONSE_BYTES + 1)
    except HTTPError as error:
        error.close()
        raise PreflightError("stripe_read_rejected") from error
    except (URLError, TimeoutError, OSError) as error:
        raise PreflightError("stripe_read_unavailable") from error
    if len(raw) > MAX_RESPONSE_BYTES:
        raise PreflightError("stripe_response_too_large")
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise PreflightError("stripe_response_invalid") from error
    if not isinstance(value, dict):
        raise PreflightError("stripe_response_invalid")
    return value


def run_preflight(
    expected_account_id: str,
    configured_prices: dict[str, str],
    api_key: str,
    request_json: Callable[[str, str], dict] | None = None,
    app_sha: str | None = None,
) -> dict:
    if request_json is None:
        request_json = stripe_json
    if not api_key.startswith("rk_test_") or len(api_key) > 512 or any(ch.isspace() for ch in api_key):
        raise PreflightError("restricted_test_key_required")
    require_identifier(expected_account_id, r"acct_[A-Za-z0-9]+", "sandbox_account_id_invalid")
    if set(configured_prices) != set(OFFERS):
        raise PreflightError("four_configured_prices_required")
    for price_id in configured_prices.values():
        require_identifier(price_id, r"price_[A-Za-z0-9_]+", "configured_price_id_invalid")
    if len(set(configured_prices.values())) != len(OFFERS):
        raise PreflightError("configured_price_ids_must_be_unique")
    if app_sha is not None and not re.fullmatch(r"[0-9a-f]{40}", app_sha):
        raise PreflightError("candidate_sha_invalid")
    api_version = server_api_version()

    account = request_json("/v1/account", api_key)
    if account.get("id") != expected_account_id:
        raise PreflightError("sandbox_account_identity_mismatch")
    observations = []
    for offer, (_env_name, expected_amount, expected_interval) in OFFERS.items():
        price_id = configured_prices[offer]
        observed = request_json(f"/v1/prices/{quote(price_id, safe='')}", api_key)
        recurring = observed.get("recurring")
        unit_amount = observed.get("unit_amount")
        interval_count = recurring.get("interval_count") if isinstance(recurring, dict) else None
        if (
            observed.get("id") != price_id
            or observed.get("active") is not True
            or observed.get("livemode") is not False
            or observed.get("currency") != "gbp"
            or type(unit_amount) is not int
            or unit_amount != expected_amount
            or not isinstance(recurring, dict)
            or recurring.get("interval") != expected_interval
            or type(interval_count) is not int
            or interval_count != 1
            or recurring.get("usage_type") != "licensed"
        ):
            raise PreflightError(f"price_catalogue_mismatch:{offer}")
        observations.append(
            {
                "offer": offer,
                "price_fingerprint": fingerprint(price_id),
                "amount_minor": expected_amount,
                "currency": "gbp",
                "interval": expected_interval,
                "interval_count": 1,
                "usage_type": "licensed",
            }
        )

    report = {
        "schema": SCHEMA,
        "captured_at": datetime.now(timezone.utc).isoformat(),
        "app_sha": app_sha,
        "api_version": api_version,
        "sandbox_account_fingerprint": fingerprint(expected_account_id),
        "key_kind": "restricted_test",
        "preflight_passed": True,
        "scenarios_executed": False,
        "write_permissions_verified": False,
        "prices": observations,
    }
    return report


def write_private_report(path_value: str | Path, report: dict) -> None:
    path = Path(path_value)
    if not path.is_absolute() or path.is_symlink():
        raise PreflightError("report_path_invalid")
    try:
        resolved = path.resolve(strict=False)
        if resolved == ROOT or ROOT in resolved.parents:
            raise PreflightError("report_must_be_outside_repository")
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        parent_mode = stat.S_IMODE(path.parent.stat().st_mode)
        if path.parent.stat().st_uid != os.getuid() or parent_mode & 0o077:
            raise PreflightError("report_directory_permissions_invalid")
        encoded = json.dumps(report, indent=2, sort_keys=True) + "\n"
        fd, temp_name = tempfile.mkstemp(prefix=".stripe-preflight-", dir=path.parent)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                stream.write(encoded)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temp_name, path)
        except BaseException:
            try:
                os.unlink(temp_name)
            except OSError:
                pass
            raise
    except PreflightError:
        raise
    except OSError as error:
        raise PreflightError("report_write_failed") from error


def required_env(name: str) -> str:
    value = os.environ.get(name, "").strip()
    if not value:
        raise PreflightError(f"required_configuration_missing:{name}")
    return value


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, help="absolute private path for the redacted preflight report")
    args = parser.parse_args(argv)
    try:
        key = read_restricted_key(required_env("STRIPE_CLOUD_LIFECYCLE_KEY_FILE"))
        configured_prices = {
            offer: required_env(env_name)
            for offer, (env_name, _amount, _interval) in OFFERS.items()
        }
        report = run_preflight(
            expected_account_id=required_env("STRIPE_CLOUD_LIFECYCLE_ACCOUNT_ID"),
            configured_prices=configured_prices,
            api_key=key,
            app_sha=required_env("SOTTO_CANDIDATE_SHA"),
        )
        write_private_report(args.output, report)
    except PreflightError as error:
        print(f"Stripe lifecycle preflight failed: {error}", file=sys.stderr)
        return 1
    print("Stripe lifecycle preflight passed: test account, pinned API version and four prices match.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
